<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="407.0" prefWidth="460.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.EtudiantController">
      <children>
         <GridPane prefHeight="409.0" prefWidth="459.0" AnchorPane.bottomAnchor="-2.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="1.0" AnchorPane.topAnchor="0.0">
            <columnConstraints>
               <ColumnConstraints hgrow="SOMETIMES" maxWidth="459.0" minWidth="10.0" prefWidth="459.0" />
               <ColumnConstraints hgrow="SOMETIMES" maxWidth="224.0" minWidth="0.0" prefWidth="0.0" />
            </columnConstraints>
            <rowConstraints>
               <RowConstraints maxHeight="86.0" minHeight="0.0" prefHeight="59.0" vgrow="SOMETIMES" />
               <RowConstraints maxHeight="270.0" minHeight="5.0" prefHeight="270.0" vgrow="SOMETIMES" />
               <RowConstraints maxHeight="237.0" minHeight="10.0" prefHeight="81.0" vgrow="SOMETIMES" />
            </rowConstraints>
             <children>
                <VBox prefHeight="52.0" prefWidth="459.0">
                   <children>
                   <TitledPane animated="false" text="Java FXML">
                     <content>
                       <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="0.0" prefWidth="457.0" />
                     </content>
                   </TitledPane>
                      <Label alignment="CENTER" centerShape="false" contentDisplay="CENTER" prefHeight="51.0" prefWidth="459.0" text="Exemple d’utilisation d’une table avec FXML" />
                   </children>
                </VBox>
                <TableView fx:id="tableView" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="270.0" prefWidth="459.0" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.vgrow="ALWAYS">
                  <columns>
                    <TableColumn prefWidth="122.0" text="Numero de DA">
                        <cellValueFactory>
                            <PropertyValueFactory property="numDA" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="111.0" text="Nom">
                        <cellValueFactory>
                            <PropertyValueFactory property="nom" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="96.0" text="Prenom">
                        <cellValueFactory>
                            <PropertyValueFactory property="prenom" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="129.0" text="Moyenne">
                        <cellValueFactory>
                            <PropertyValueFactory property="moyenne" />
                        </cellValueFactory>
                    </TableColumn>
                  </columns>
                </TableView>
                <HBox alignment="CENTER" prefHeight="81.0" prefWidth="459.0" spacing="5.0" GridPane.hgrow="ALWAYS" GridPane.rowIndex="2" GridPane.vgrow="ALWAYS">
                   <TextField fx:id="NumDA" prefWidth="70.0" promptText="No DA" />
                   <TextField fx:id="Nom" prefWidth="80.0" promptText="Nom" />
                   <TextField fx:id="Prenom" prefWidth="80.0" promptText="Prénom" />
                   <TextField fx:id="Moyenne" prefWidth="70.0" promptText="Moyenne" />
                   <Button onAction="#ajouterEtudiant" text="Ajouter" />
                </HBox>
             </children>
         </GridPane>
      </children>
